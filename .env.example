# Hardhat settings — copy to .env (never commit .env).
# Only needed for deploying to Sepolia; compiling and testing work without it.

# Private key of a TEST wallet used to deploy (MetaMask > Account details > Show private key).
# Never use a wallet that holds real funds.
PRIVATE_KEY=

# Sepolia RPC endpoint, e.g. from Alchemy or Infura
SEPOLIA_RPC_URL=

# Payout wallets and their share of every sale (comma-separated, same order, must total 100).
# If left empty on localhost, Hardhat test accounts #1–#3 are used with 40,30,30.
ARTIST_ADDRESSES=
ARTIST_PERCENTAGES=40,30,30
