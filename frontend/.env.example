# Frontend settings — copy to frontend/.env (never commit it).
# NEXT_PUBLIC_* values are bundled into the browser; everything else stays on the server.

# Printed by `npm run deploy:sepolia`
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Wallets that see the artist dashboard — use the same addresses the contract was deployed with
NEXT_PUBLIC_ARTIST_ADDRESSES=

# Product IDs to hide from the marketplace (comma-separated)
NEXT_PUBLIC_HIDDEN_PRODUCT_IDS=0

# Pinata JWT for IPFS uploads (app.pinata.cloud > API Keys). Server-only — do NOT prefix with NEXT_PUBLIC_.
PINATA_JWT=
